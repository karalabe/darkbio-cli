+/// Prints test-only syscall and coordination events without frame contents.
+#[cfg(test)]
+#[expect(clippy::disallowed_methods, reason = "diagnostic timestamps only")]
+pub(super) fn trace(event: &str, detail: impl std::fmt::Debug) {
+    /// Monotonic origin shared by this test process's diagnostics.
+    static START: std::sync::OnceLock<Instant> = std::sync::OnceLock::new();
+    /// Per-process trace file, separate from libtest's console output.
+    static OUTPUT: std::sync::OnceLock<std::sync::Mutex<std::fs::File>> =
+        std::sync::OnceLock::new();
+    let line = format!(
+        "[relay-trace {:?} {:?}] {event} {detail:?}",
+        START.get_or_init(Instant::now).elapsed(),
+        std::thread::current()
+    );
+    let output = OUTPUT.get_or_init(|| {
+        let path = std::env::var_os("RELAY_TRACE_FILE").expect("trace file configured by harness");
+        std::sync::Mutex::new(std::fs::File::create(path).expect("trace file writable"))
+    });
+    writeln!(output.lock().unwrap(), "{line}").expect("trace event written");
+}
+
+/// Records a native handle without querying or changing the socket's state.
+#[cfg(test)]
+pub(super) fn trace_socket(event: &str, socket: &TcpStream, detail: impl std::fmt::Debug) {
+    #[cfg(windows)]
+    let handle = std::os::windows::io::AsRawSocket::as_raw_socket(socket);
+    #[cfg(unix)]
+    let handle = std::os::fd::AsRawFd::as_raw_fd(socket);
+    trace(event, (handle, detail));
+}
